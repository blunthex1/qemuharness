<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>QvmManager</AssemblyName>
    <RootNamespace>QvmManager</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- See README.md for the "dotnet publish" command that builds a single standalone exe.
         WPF ships some native (non-.NET) DLLs like wpfgfx_cor3.dll - PublishSingleFile doesn't
         bundle those into the single exe by default, which crashes at startup with a
         DllNotFoundException. This setting makes the exe extract them to a temp folder at
         first run instead, so the single-file exe actually works for a WPF app. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\qvm.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The .exe icon (ApplicationIcon above) is baked in at compile time, but the
       Window.Icon="Assets/qvm.ico" references in the XAML files (for the taskbar/
       title-bar icon while running) load it as a pack-URI resource at runtime -
       SDK-style WPF projects don't auto-include a raw .ico as a resource, so without
       this it throws "Provide value on ImageSourceConverter threw an exception" the
       moment a window with Icon=... tries to load. -->
  <ItemGroup>
    <Resource Include="Assets\qvm.ico" />
  </ItemGroup>

</Project>
